# ============================================================================
#  Dziennik Praktyk — ochrona zasobów serwera (Apache)
#  Wymaga włączonego .htaccess (Laragon: <Directory> AllowOverride All).
# ============================================================================

# Brak listowania zawartości katalogów (gdyby ktoś trafił na pusty katalog).
Options -Indexes

# 1) Zablokuj pliki bazy danych oraz pliki towarzyszące (WAL / SHM / journal).
<FilesMatch "(?i)\.(db|sqlite|sqlite3|db-journal|db-wal|db-shm|sql)$">
    Require all denied
</FilesMatch>

# 2) Zablokuj pliki ukryte (m.in. .gitignore, .htaccess).
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# 3) Zablokuj katalog .git (historia repo) oraz bezpośredni dostęp do src/.
RedirectMatch 404 (?i)/(\.git|src)(/|$)

# 4) Kompresja odpowiedzi tekstowych (mniejszy transfer, szybsze ładowanie).
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
    AddOutputFilterByType DEFLATE text/javascript application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# 5) Buforowanie zasobów statycznych. Pliki CSS/JS/obrazów są odwoływane
#    z parametrem ?v=<mtime>, więc po zmianie adres się zmienia i można je
#    trzymać w przeglądarce bardzo długo.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                  "access plus 1 year"
    ExpiresByType text/javascript           "access plus 1 year"
    ExpiresByType application/javascript    "access plus 1 year"
    ExpiresByType image/png                 "access plus 1 year"
    ExpiresByType image/svg+xml             "access plus 1 year"
    ExpiresByType image/x-icon              "access plus 1 year"
    ExpiresByType image/vnd.microsoft.icon  "access plus 1 year"
</IfModule>
